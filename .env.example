# Copy this file to .env and fill in real credentials. .env is gitignored.

# Google OAuth (Drive backup)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:17234/api/backups/google/callback
GOOGLE_FRONTEND_REDIRECT_BASE=http://127.0.0.1:17234

# MySQL shop-server mode (application-mysql.yml)
MYSQL_USERNAME=lumi
MYSQL_PASSWORD=

# JWT signing fallback (JwtSecretService auto-creates C:/LumiPOS/jwt.secret on first run)
JWT_SECRET=
JWT_EXPIRATION=86400000