<resources>
    <!-- Base application theme. Compose handles the Material 3 theming at runtime. -->
    <style name="Theme.LumiPOS" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="NoActionBar" parent="Theme.LumiPOS">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>