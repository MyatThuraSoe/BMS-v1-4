<?xml version="1.0" encoding="utf-8"?>
<!--
  Spinner option labels for the receipt customization screen.

  These are display labels only. The values persisted to ReceiptCustomization are the codes the
  renderer understands ("58"/"80", "small"/"normal"/"large", "left"/"center"/"right",
  "dashed"/"solid"/"dotted"), and the fragment maps spinner position -> code by index. Keep the
  order here in sync with the `when`/listOf mappings in ReceiptCustomizationFragment.
-->
<resources>
    <string-array name="receipt_paper_sizes">
        <item>58 mm</item>
        <item>80 mm</item>
    </string-array>

    <string-array name="receipt_font_sizes">
        <item>Small</item>
        <item>Normal</item>
        <item>Large</item>
    </string-array>

    <string-array name="receipt_header_aligns">
        <item>Left</item>
        <item>Center</item>
        <item>Right</item>
    </string-array>

    <string-array name="receipt_divider_styles">
        <item>Dashed</item>
        <item>Solid</item>
        <item>Dotted</item>
    </string-array>
</resources>
