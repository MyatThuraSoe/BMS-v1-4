<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dashed top edge -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/receipt_border"
                android:dashWidth="6dp"
                android:dashGap="4dp" />
        </shape>
    </item>
    <!-- Bottom border -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/receipt_border" />
            <solid android:color="@color/receipt_background" />
        </shape>
    </item>
</layer-list>
