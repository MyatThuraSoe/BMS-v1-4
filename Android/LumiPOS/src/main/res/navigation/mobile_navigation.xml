        tools:layout="@layout/fragment_customer_form">
        <argument
            android:name="customerId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/suppliersFragment"
        android:name="com.example.lumipos.ui.suppliers.SuppliersFragment"
        android:label="Suppliers"
        tools:layout="@layout/fragment_suppliers" />

    <fragment
        android:id="@+id/supplierFormFragment"
        android:name="com.example.lumipos.ui.suppliers.SupplierFormFragment"
