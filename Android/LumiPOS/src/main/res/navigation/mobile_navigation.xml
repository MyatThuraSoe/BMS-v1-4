<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lumipos_nav"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.lumipos.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/posFragment"
        android:name="com.example.lumipos.ui.pos.POSFragment"
        android:label="Point of Sale"
        tools:layout="@layout/fragment_pos" />

    <fragment
        android:id="@+id/productsFragment"
        android:name="com.example.lumipos.ui.products.ProductsFragment"
        android:label="Products"
        tools:layout="@layout/fragment_products" />

    <fragment
        android:id="@+id/productFormFragment"
        android:name="com.example.lumipos.ui.products.ProductFormFragment"
        android:label="Product Form"
        tools:layout="@layout/fragment_product_form">
        <argument
            android:name="productId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/categoriesFragment"
        android:name="com.example.lumipos.ui.categories.CategoriesFragment"
        android:label="Categories"
        tools:layout="@layout/fragment_categories" />

    <fragment
        android:id="@+id/categoryFormFragment"
        android:name="com.example.lumipos.ui.categories.CategoryFormFragment"
        android:label="Category Form"
        tools:layout="@layout/fragment_category_form">
        <argument
            android:name="categoryId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/customersFragment"
        android:name="com.example.lumipos.ui.customers.CustomersFragment"
        android:label="Customers"
        tools:layout="@layout/fragment_customers" />

    <fragment
        android:id="@+id/customerFormFragment"
        android:name="com.example.lumipos.ui.customers.CustomerFormFragment"
