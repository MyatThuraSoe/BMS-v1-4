        android:id="@+id/accountsReceivableFragment"
        android:name="com.example.lumipos.ui.ar.AccountsReceivableFragment"
        android:label="Accounts Receivable"
        tools:layout="@layout/fragment_accounts_receivable" />

    <fragment
        android:id="@+id/inventoryFragment"
        android:name="com.example.lumipos.ui.inventory.InventoryFragment"
