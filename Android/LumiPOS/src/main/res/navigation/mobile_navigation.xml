        <argument
            android:name="supplierId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/salesFragment"
        android:name="com.example.lumipos.ui.sales.SalesFragment"
        android:label="Sales"
        tools:layout="@layout/fragment_sales" />

    <fragment
        android:id="@+id/returnsFragment"
        android:name="com.example.lumipos.ui.returns.ReturnsFragment"
        android:label="Returns"
        tools:layout="@layout/fragment_returns" />

