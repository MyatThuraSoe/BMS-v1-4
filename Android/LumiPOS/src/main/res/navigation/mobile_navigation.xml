        android:id="@+id/promotionsFragment"
        android:name="com.example.lumipos.ui.promotions.PromotionsFragment"
        android:label="Promotions"
        tools:layout="@layout/fragment_promotions" />

    <fragment
        android:id="@+id/returnFormFragment"
        android:name="com.example.lumipos.ui.returns.ReturnFormFragment"
        android:label="Return Form"
        tools:layout="@layout/fragment_return_form">
        <argument
            android:name="saleId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/saleDetailFragment"
        android:name="com.example.lumipos.ui.sales.SaleDetailFragment"
        android:label="Sale Details"
        tools:layout="@layout/fragment_sale_detail">
        <argument
            android:name="saleId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

