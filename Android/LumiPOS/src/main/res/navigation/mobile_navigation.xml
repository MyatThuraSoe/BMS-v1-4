        android:name="com.example.lumipos.ui.purchases.PurchaseFormFragment"
        android:label="New Purchase"
        tools:layout="@layout/fragment_purchase_form" />

    <fragment
        android:id="@+id/expensesFragment"
        android:name="com.example.lumipos.ui.expenses.ExpensesFragment"
        android:label="Expenses"
        tools:layout="@layout/fragment_expenses" />

    <fragment
        android:id="@+id/expenseFormFragment"
        android:name="com.example.lumipos.ui.expenses.ExpenseFormFragment"
        android:label="Expense Form"
        tools:layout="@layout/fragment_expense_form">
        <argument
            android:name="expenseId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/reportsFragment"
        android:name="com.example.lumipos.ui.reports.ReportsFragment"
        android:label="Reports"
        tools:layout="@layout/fragment_reports" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.lumipos.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/auditLogFragment"
        android:name="com.example.lumipos.ui.audit.AuditLogFragment"
        android:label="@string/title_audit_logs"
        tools:layout="@layout/fragment_audit_log" />

    <fragment
        android:id="@+id/shopInfoFragment"
        android:name="com.example.lumipos.ui.shopinfo.ShopInfoFragment"
        android:label="Shop Information"
        tools:layout="@layout/fragment_shop_info" />

    <fragment
        android:id="@+id/receiptCustomizationFragment"
        android:name="com.example.lumipos.ui.receipt.ReceiptCustomizationFragment"
        android:label="Receipt Customization"
        tools:layout="@layout/fragment_receipt_customization" />

    <fragment
        android:id="@+id/receiptPreviewFragment"
        android:name="com.example.lumipos.ui.receipt.ReceiptPreviewFragment"
