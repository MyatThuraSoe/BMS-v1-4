<?xml version="1.0" encoding="utf-8"?>
<!--
  Receipt customization.

  Two things to know about this screen:

  1. The two spinner pairs used to sit side by side with no captions at all, so "58 / Small" and
     "Left / Dashed" were unidentifiable. Each spinner now has its own caption.
  2. The preview is generated by ReceiptGenerator - the same renderer that produces the printed
     receipt - so every switch below has a visible effect. The previous hand-rolled preview
     silently ignored Show Logo, Show Address, Show Phone, Show QR, Show Tax and Show Discount.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ============================ PREVIEW ============================ -->

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.LumiPOS.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/receipt_preview_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/receipt_preview_note"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!--
                  White regardless of theme: this is a paper receipt mock-up, so it must look
                  like paper even if the app is ever shown on a dark surface.
                -->
                <LinearLayout
                    android:id="@+id/receipt_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:minHeight="120dp"
                    android:orientation="vertical"
                    android:padding="12dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ============================ SETTINGS =========================== -->

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.LumiPOS.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/receipt_settings_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.LumiPOS.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/label_header_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_header_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.LumiPOS.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/label_main_message">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_main_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.LumiPOS.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/label_footer_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_footer_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Paper size / font size, each captioned. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_paper_size"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/sp_paper_size"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:listitem="@android:layout/simple_spinner_item" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_font_size"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/sp_font_size"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:listitem="@android:layout/simple_spinner_item" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Header alignment / divider style, each captioned. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_header_align"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/sp_header_align"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:listitem="@android:layout/simple_spinner_item" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_divider_style"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/sp_divider_style"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:listitem="@android:layout/simple_spinner_item" />

                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_show_logo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/sw_show_logo" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_show_shop_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/sw_show_shop_name" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_show_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/sw_show_address" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_show_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/sw_show_phone" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_show_qr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/sw_show_qr" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_show_credit_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/sw_show_credit_info" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_show_tax"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/sw_show_tax" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_show_discount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/sw_show_discount" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_bold_shop_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/sw_bold_shop_name" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_receipt_settings"
                    style="@style/Widget.LumiPOS.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_save" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
