<?xml version="1.0" encoding="utf-8"?>
<!--
  Invoice detail sheet for Accounts Receivable.

  This is a custom layout rather than AlertDialog.setMessage because the payment
  history is fetched asynchronously: the dialog is already on screen by the time the
  rows arrive, so they have to be injected into a view we hold a reference to.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_invoice_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="@color/outline_variant" />

        <TextView
            android:id="@+id/tv_payment_history_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/label_payment_history"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Populated by the selectedPayments observer once the query returns. -->
        <TextView
            android:id="@+id/tv_payment_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="@string/loading"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
