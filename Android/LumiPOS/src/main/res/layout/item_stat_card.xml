<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared stat card. Both the icon and the label start EMPTY on purpose: an <include>
  cannot supply attributes to the included layout's children, so every including screen
  must populate them itself (see the statLabels / statIcons lists in the fragments).

  Note for callers: an android:id on <include> resolves to THIS MaterialCardView, never
  to a child. Always findViewById(cardId) first, then look inside it.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">

        <ImageView
            android:id="@+id/iv_stat_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginBottom="6dp"
            android:importantForAccessibility="no"
            android:tint="@color/primary" />

        <TextView
            android:id="@+id/tv_stat_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tv_stat_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
